root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# src/*.txt is the workbook's own text, compared byte for byte with the Advanced
# Formula Environment store by tools/verify_afe.py. Trimming the alignment padding
# on save, or adding a final newline, breaks that gate with no hint why.
[src/*.txt]
trim_trailing_whitespace = false
insert_final_newline = false
